# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Secrets ---
# Local credentials (DB + SMTP). Copy backend/config.example.php -> backend/config.php.
backend/config.php

# --- Resident PII: uploaded valid IDs, ID-holding photos, incident evidence, proofs ---
# These are real citizen documents. Never commit them.
backend/api/uploads/
backend/uploads/*
/uploads/

# Server hardening file for the uploads root (disables script execution there) -
# not PII, and needs to ship with every deploy, so it's the one tracked exception.
!backend/uploads/.htaccess

# --- Database dumps ---
# barangay_bims.sql contains live users/residents/admins rows and password hashes.
# Commit a schema-only dump instead: mysqldump --no-data barangay_bims > schema.sql
*.sql
!schema.sql

# Schema migrations are structure-only (no rows) and must ship with the code
# that depends on them.
!backend/migrations/*.sql

# Composer deps (restore with: cd backend/api && composer install)
backend/api/vendor/

# Environment variables
.env
.env.*.local

# Windows OS files
Thumbs.db

# Build/cache
.vite/

# Stray artifact from a shell run in this directory
Microsoft/
